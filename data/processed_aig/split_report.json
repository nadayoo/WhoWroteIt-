    "chars": [
      50,
      5000
    ],
    "lines": [
      3,
      200
    ],
    "applied_to": "all sources"
  },
  "python2_dropped": true,
  "dedup": "exact hash on code_norm, then token-level hash ignoring comments/whitespace",
  "dedup_priority": "human over AI, AIGCodeSet over CodeNet",
  "imbalance_strategy": "downsample CodeNet human rows so human:AI <= 3.0 in every split, then class weights on train",
  "class_weights_train": {
    "0": 0.7513,
    "1": 1.4949
  },
